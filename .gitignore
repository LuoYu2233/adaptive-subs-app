# API keys: never commit
.env
*.env
!.env.example

# your learner profile and word marks (personal)
profile.json
profile.tmp
.profile.json.lock
.profile-*.tmp
/profile-backups/

# local Python environment and caches
.venv/
__pycache__/
*.pyc
.cache/

# generated by packaging/build.py: speech model (~76 MB) and English word ranks
app/models/
app/data/ranks_en.txt

# build outputs (the Windows program goes to GitHub Releases, the web demo to GitHub Pages)
build/
release/
site/

# videos you processed when running from source (other people's content, made locally)
data/

# editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# logs when run from source
logs/
