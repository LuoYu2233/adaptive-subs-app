# 复制这个文件为 .env，填入你自己的 key（.env 不要分享给别人）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# 注释模型：openai / deepseek / mimo（也可以在设置页 http://127.0.0.1:8765/setup 里选）
ANNOTATION_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# 可选：换 OpenAI 模型
# OPENAI_MODEL=gpt-6-luna
# DEEPSEEK_MODEL=deepseek-flash
# MIMO_MODEL=mimo-v2.6-flash

# 可选：语音识别（B 站插件里没有英文字幕的视频用）。小米 MiMo，OpenAI 兼容接口
# MIMO_API_KEY=sk-xxxxxxxxxxxxxxxx
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# ASR_MODEL=mimo-v2.5-asr
